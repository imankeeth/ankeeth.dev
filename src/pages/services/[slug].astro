---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";
import { SERVICES_DATA } from "../../constants";
import Panel from "../../components/react/Panel";
import TechButton from "../../components/react/TechButton";
import BracketLink from "../../components/react/BracketLink";

// Get slug from URL params (SSR mode)
const { slug } = Astro.params;

// Find service from SERVICES_DATA
const service = SERVICES_DATA.find((s) => s.slug === slug);

// 404 if service not found
if (!service) {
  return Astro.redirect('/services');
}

// Try to get content from collection, fallback to SERVICES_DATA
let Content;
try {
  const collection = await getCollection("services");
  const entry = collection.find((e) => e.slug === slug);
  if (entry) {
    const { Content: MDXContent } = await entry.render();
    Content = MDXContent;
  }
} catch (e) {
  // Content collection might not exist yet
}
---

<Layout title={`${service.title} | ankeeth.dev`} description={service.description}>
  <div class="pb-20 max-w-[1920px] mx-auto">
    <div class="mb-6">
      <a href="/services" class="flex items-center gap-2 text-xs font-mono text-gray-500 hover:text-accent-teal transition-colors uppercase tracking-wider">
        ← Return to Services
      </a>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
      
      <!-- Left Column: Main Content -->
      <div class="lg:col-span-8 space-y-6">
        <div class="relative flex flex-col bg-surface-light dark:bg-surface border border-border-subtle-light dark:border-border-subtle rounded-none shadow-sm dark:shadow-none min-h-[600px]">
          
          <!-- Header -->
          <div class="flex items-center justify-between px-4 py-3 border-b border-border-subtle-light dark:border-border-subtle bg-black/[0.02] dark:bg-white/[0.02] shrink-0">
            <div class="flex items-baseline gap-2 min-w-0">
              <h3 class="text-xs font-semibold font-mono tracking-widest text-gray-900 dark:text-gray-100 uppercase truncate">
                MANIFEST: {service.id.toUpperCase()}
              </h3>
              <span class="text-[10px] text-gray-500 font-sans truncate">OPERATIONAL_BRIEF</span>
            </div>
          </div>

          <!-- Body -->
          <div class="flex-1 min-h-0 p-4">
            <div class="max-w-3xl">
              <header class="mb-10 pb-8 border-b border-gray-200 dark:border-white/10">
                <h1 class="text-3xl md:text-4xl font-mono font-bold text-gray-900 dark:text-white uppercase tracking-tight mb-4 leading-tight">
                  {service.title}
                </h1>
                <p class="text-base md:text-lg text-gray-600 dark:text-gray-400 leading-relaxed font-sans">
                  {service.description}
                </p>
                <div class="flex flex-wrap gap-2 mt-6">
                  {service.tags.map((tag: string) => (
                    <span class="px-2 py-1 bg-accent-teal/5 border border-accent-teal/20 text-accent-teal text-[10px] font-mono uppercase tracking-wider">
                      #{tag}
                    </span>
                  ))}
                </div>
              </header>

              <article class="prose prose-sm dark:prose-invert max-w-none">
                {Content ? (
                  <Content />
                ) : (
                  <div set:html={service.detailedDescription.replace(/\n/g, '<br/>')} class="text-sm text-gray-700 dark:text-gray-300 leading-7" />
                )}
              </article>

              <div class="mt-12 pt-8 border-t border-gray-200 dark:border-white/10">
                <a 
                  href="https://cal.com/ankeeth/30min" 
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-2 px-6 py-3 bg-gray-900 text-white dark:bg-white dark:text-black text-xs font-medium uppercase tracking-wider hover:bg-gray-800 dark:hover:bg-gray-200 transition-colors"
                >
                  Initiate_Engagement →
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Right Column: Sidebar Specs -->
      <div class="lg:col-span-4 space-y-6 lg:sticky lg:top-24">
        
        <!-- Protocol Specs -->
        <div class="relative flex flex-col bg-surface-light dark:bg-surface border border-border-subtle-light dark:border-border-subtle">
          <div class="flex items-center justify-between px-4 py-3 border-b border-border-subtle-light dark:border-border-subtle bg-black/[0.02] dark:bg-white/[0.02]">
            <h3 class="text-xs font-semibold font-mono tracking-widest text-gray-900 dark:text-gray-100 uppercase">PROTOCOL_SPECS</h3>
          </div>
          <div class="p-5 bg-gray-50 dark:bg-black/20">
            <ul class="space-y-4">
              {service.deliverables?.map((item: string) => (
                <li class="flex items-start gap-3">
                  <div class="w-5 h-5 rounded-full bg-accent-green/10 flex items-center justify-center shrink-0 mt-0.5">
                    <svg class="w-2.5 h-2.5 text-accent-green" fill="currentColor" viewBox="0 0 20 20">
                      <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                    </svg>
                  </div>
                  <span class="text-sm font-mono text-gray-700 dark:text-gray-300">{item}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>

        <!-- Target Audience -->
        <div class="relative flex flex-col bg-surface-light dark:bg-surface border border-border-subtle-light dark:border-border-subtle">
          <div class="flex items-center justify-between px-4 py-3 border-b border-border-subtle-light dark:border-border-subtle bg-black/[0.02] dark:bg-white/[0.02]">
            <h3 class="text-xs font-semibold font-mono tracking-widest text-gray-900 dark:text-gray-100 uppercase">TARGET_PROFILE</h3>
          </div>
          <div class="p-5">
            <span class="text-sm font-bold font-mono text-gray-900 dark:text-white">{service.targetAudience}</span>
            <p class="text-xs text-gray-500 dark:text-gray-400 leading-relaxed mt-2">
              Designed for organizations that need high-velocity execution and are ready to bypass standard industry inefficiencies.
            </p>
          </div>
        </div>

        <!-- Availability -->
        <div class="relative flex flex-col bg-surface-light dark:bg-surface border border-border-subtle-light dark:border-border-subtle">
          <div class="flex items-center justify-between px-4 py-3 border-b border-border-subtle-light dark:border-border-subtle bg-black/[0.02] dark:bg-white/[0.02]">
            <h3 class="text-xs font-semibold font-mono tracking-widest text-gray-900 dark:text-gray-100 uppercase">SYSTEM_STATUS</h3>
          </div>
          <div class="p-5 text-center">
            <div class="inline-flex items-center gap-2 px-3 py-1 bg-accent-green/10 text-accent-green text-xs font-mono uppercase rounded-full mb-3">
              <span class="w-1.5 h-1.5 bg-accent-green rounded-full animate-pulse"></span>
              Open for Q1 2026
            </div>
            <p class="text-[10px] text-gray-400 font-mono">
              Limited slots available. Priority given to long-term partnerships.
            </p>
          </div>
          <div class="border-t border-gray-200 dark:border-white/10 p-2 text-center">
            <a href="https://cal.com/ankeeth/30min" target="_blank" rel="noreferrer" class="text-xs font-mono text-gray-500 hover:text-accent-teal uppercase">Check Calendar</a>
          </div>
        </div>

      </div>
    </div>
  </div>
</Layout>
