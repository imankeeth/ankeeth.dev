---
import Layout from "../layouts/Layout.astro";
import Panel from "../components/react/Panel";
---

<Layout title="404 | ankeeth.dev" description="The page you requested could not be found.">
  <section class="min-h-[calc(100vh-14rem)] flex items-center justify-center">
    <div class="w-full max-w-3xl">
      <Panel title="SYSTEM_ROUTE" subtitle="ERROR_STATE">
        <div class="min-h-[260px] flex flex-col items-center justify-center text-center">
          <p class="text-[11px] font-mono uppercase tracking-[0.2em] text-accent-teal mb-4">Error_404</p>
          <h1 class="text-3xl md:text-4xl font-mono font-medium tracking-tight text-gray-900 dark:text-white mb-3">
            Route not found
          </h1>
          <p class="text-base text-gray-600 dark:text-gray-400 max-w-xl leading-relaxed mb-8">
            The page you requested does not exist or may have moved.
          </p>
        </div>
      </Panel>
    </div>
  </section>
</Layout>
