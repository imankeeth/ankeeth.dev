---
import Layout from "../../layouts/Layout.astro";
import { getEntry } from "astro:content";
import AuthorProfile from "../../components/react/AuthorProfile";

const slug = Astro.params.slug;
const entry = slug ? await getEntry("writings", slug) : undefined;
if (!entry) {
  return Astro.redirect("/writings");
}
const { Content } = await entry.render();
const { title, date, tags, coverImage, hasAudio, description } = entry.data;
---

<Layout title={`${title} | ankeeth.dev`} description={description}>
  <div class="pb-20 max-w-7xl mx-auto">
    <!-- Top Controls -->
    <div class="flex justify-between items-center mb-6">
      <a href="/writings" class="flex items-center gap-2 text-xs font-mono text-gray-500 hover:text-accent-teal transition-colors uppercase tracking-wider">
        ← Back to Archives
      </a>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
      <!-- Main Article -->
      <div class="lg:col-span-8">
        <div class="relative flex flex-col bg-surface-light dark:bg-surface border border-border-subtle-light dark:border-border-subtle rounded-none shadow-sm dark:shadow-none min-h-[80vh]">
        
        <!-- Header -->
        <div class="flex items-center justify-between px-4 py-3 border-b border-border-subtle-light dark:border-border-subtle bg-black/[0.02] dark:bg-white/[0.02] shrink-0">
          <div class="flex items-baseline gap-2 min-w-0">
            <h3 class="text-xs font-semibold font-mono tracking-widest text-gray-900 dark:text-gray-100 uppercase truncate">
              LOG_ENTRY: {entry.slug.toUpperCase()}
            </h3>
            <span class="text-[10px] text-gray-500 font-sans">FOCUS_PROTOCOL_ACTIVE</span>
          </div>
        </div>

          <!-- Body -->
          <article class="flex-1 min-h-0 p-4 md:p-8">
          
          <!-- Header Section -->
          <header class="mb-10">
            {coverImage && (
              <div class="relative w-full aspect-[21/9] overflow-hidden mb-10 border border-gray-200 dark:border-white/10 group">
                <img 
                  src={coverImage} 
                  alt="Cover" 
                  class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" 
                />
                <div class="absolute inset-0 border-[4px] border-surface-light dark:border-surface opacity-50"></div>
                <div class="absolute top-2 right-2 px-2 py-1 bg-black/80 text-accent-teal text-[10px] font-mono tracking-widest uppercase backdrop-blur-md">
                  IMG_SOURCE_Render
                </div>
              </div>
            )}

            <h1 class="text-3xl md:text-4xl lg:text-5xl font-mono font-bold text-gray-900 dark:text-white tracking-tighter mb-8 leading-tight uppercase">
              {title}
            </h1>

            <div class="flex flex-wrap items-center gap-6 text-xs font-mono text-gray-500 dark:text-gray-400 mb-8 pb-8 border-b border-gray-200 dark:border-white/10">
              <span class="flex items-center gap-2">
                📅 {date}
              </span>
              {hasAudio && (
                <span class="flex items-center gap-2 text-accent-orange">
                  🎧 Audio Available
                </span>
              )}
            </div>

            <!-- Tags -->
            <div class="flex flex-wrap gap-2">
              {tags.map((tag: string) => (
                <span class="px-3 py-1 bg-accent-teal/5 border border-accent-teal/20 text-accent-teal text-[10px] font-mono uppercase tracking-wider rounded-full">
                  #{tag}
                </span>
              ))}
            </div>
          </header>

          <!-- Content Body -->
          <div class="prose prose-lg dark:prose-invert max-w-none 
            prose-headings:font-mono prose-headings:uppercase prose-headings:tracking-tight
            prose-h2:text-2xl prose-h2:mt-16 prose-h2:mb-6 prose-h2:border-b prose-h2:border-gray-200 prose-h2:dark:border-white/10 prose-h2:pb-2
            prose-h3:text-xl prose-h3:mt-12 prose-h3:mb-4 prose-h3:text-gray-800 prose-h3:dark:text-gray-200
            prose-p:text-base prose-p:md:text-lg prose-p:leading-8 prose-p:text-gray-700 prose-p:dark:text-gray-300 prose-p:mb-8
            prose-a:text-accent-teal prose-a:no-underline hover:prose-a:underline
            prose-code:bg-gray-100 prose-code:dark:bg-white/10 prose-code:text-accent-teal prose-code:px-1.5 prose-code:py-0.5 prose-code:rounded-sm prose-code:text-sm prose-code:border prose-code:border-gray-200 prose-code:dark:border-white/5
            prose-pre:bg-gray-100 prose-pre:dark:bg-black/40 prose-pre:border prose-pre:border-gray-200 prose-pre:dark:border-white/10 prose-pre:rounded-sm prose-pre:shadow-inner
            prose-blockquote:border-l-4 prose-blockquote:border-accent-orange prose-blockquote:pl-6 prose-blockquote:py-4 prose-blockquote:my-10 prose-blockquote:bg-accent-orange/5 prose-blockquote:rounded-r-sm prose-blockquote:italic prose-blockquote:text-gray-600 prose-blockquote:dark:text-gray-400
            prose-ul:list-disc prose-ul:pl-6 prose-ul:mb-8 prose-ul:space-y-3
            prose-ol:list-decimal prose-ol:pl-6 prose-ol:mb-8 prose-ol:space-y-3
            prose-li:marker:text-accent-teal
            prose-hr:my-12 prose-hr:border-gray-200 prose-hr:dark:border-white/10 prose-hr:border-dashed
            prose-strong:text-gray-900 prose-strong:dark:text-white
            prose-img:border prose-img:border-gray-200 prose-img:dark:border-white/10 prose-img:p-1 prose-img:bg-white prose-img:dark:bg-black/20 prose-img:rounded-sm
          ">
            <Content />
          </div>

            <!-- Author Profile (mobile/tablet) -->
            <div class="mt-20 pt-10 border-t border-gray-200 dark:border-white/10 lg:hidden">
              <AuthorProfile client:visible />
            </div>

            <!-- Footer Nav -->
            <div class="mt-20 pt-8 border-t border-gray-200 dark:border-white/10">
              <div class="flex justify-between items-center">
                <a href="/writings" class="text-xs font-mono text-gray-500 hover:text-accent-teal transition-colors">[RETURN_TO_INDEX]</a>
                <div class="text-xs font-mono text-gray-400">END_OF_FILE</div>
              </div>
            </div>
          </article>
        </div>
      </div>

      <!-- Static Sidebar (desktop) -->
      <aside class="hidden lg:block lg:col-span-4 lg:sticky lg:top-24 space-y-6">
        <div class="bg-surface-light dark:bg-surface border border-border-subtle-light dark:border-border-subtle p-4">
          <h3 class="text-xs font-semibold font-mono tracking-widest text-gray-900 dark:text-gray-100 uppercase mb-4">
            ARTICLE_CONTEXT
          </h3>
          <div class="space-y-3 text-xs font-mono text-gray-600 dark:text-gray-300">
            <div class="flex items-center justify-between gap-3 border-b border-border-subtle-light dark:border-border-subtle pb-2">
              <span class="uppercase tracking-wide text-gray-500 dark:text-gray-400">DATE</span>
              <span class="text-right">{date}</span>
            </div>
            <div class="flex items-center justify-between gap-3 border-b border-border-subtle-light dark:border-border-subtle pb-2">
              <span class="uppercase tracking-wide text-gray-500 dark:text-gray-400">AUDIO</span>
              <span class={hasAudio ? "text-accent-orange" : "text-gray-500 dark:text-gray-400"}>
                {hasAudio ? "AVAILABLE" : "NONE"}
              </span>
            </div>
            <div class="pt-1">
              <div class="uppercase tracking-wide text-gray-500 dark:text-gray-400 mb-2">TAGS</div>
              <div class="flex flex-wrap gap-2">
                {tags.map((tag: string) => (
                  <span class="px-2 py-1 bg-accent-teal/5 border border-accent-teal/20 text-accent-teal text-[10px] font-mono uppercase tracking-wider rounded-full">
                    #{tag}
                  </span>
                ))}
              </div>
            </div>
          </div>
        </div>

        <AuthorProfile client:visible />
      </aside>
    </div>
  </div>
</Layout>
