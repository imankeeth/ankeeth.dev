---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";
import BracketLink from "../../components/react/BracketLink";

// Get slug from URL params (SSR mode)
const { slug } = Astro.params;

// Find entry from collection
const experiments = await getCollection("experiments");
const entry = experiments.find((e) => e.slug === slug);

// 404 if not found
if (!entry) {
  return Astro.redirect('/experiments');
}

const { Content } = await entry.render();
const { title, subtitle, status, version, description, techStack, icon, githubUrl, demoUrl, date } = entry.data;
---

<Layout title={`${title} | ankeeth.dev`} description={description}>
  <div class="pb-20">
    <div class="mb-6">
      <a href="/experiments" class="flex items-center gap-2 text-xs font-mono text-gray-500 hover:text-accent-teal transition-colors uppercase tracking-wider">
        ← Return to Lab
      </a>
    </div>

    <div class="max-w-4xl mx-auto">
      <!-- Header Manifest -->
      <div class="relative flex flex-col bg-surface-light dark:bg-surface border border-border-subtle-light dark:border-border-subtle mb-8">
        
        <!-- Header -->
        <div class="flex items-center justify-between px-4 py-3 border-b border-border-subtle-light dark:border-border-subtle bg-black/[0.02] dark:bg-white/[0.02]">
          <div class="flex items-baseline gap-2 min-w-0">
            <h3 class="text-xs font-semibold font-mono tracking-widest text-gray-900 dark:text-gray-100 uppercase truncate">
              MANIFEST: {entry.slug.toUpperCase()}
            </h3>
            <span class="text-[10px] text-gray-500 font-sans">{status.toUpperCase()}</span>
          </div>
          <div class="w-3 h-3 bg-accent-blue rounded-full animate-pulse"></div>
        </div>

        <!-- Body -->
        <div class="p-6">
          <div class="flex flex-col md:flex-row gap-8 items-start">
            <div class="flex-1">
              <h1 class="text-3xl md:text-4xl font-mono font-bold text-gray-900 dark:text-white uppercase tracking-tight mb-2">
                {title}
              </h1>
              <p class="text-sm font-mono text-accent-blue mb-4 uppercase tracking-wider">
                {subtitle}
              </p>
              <p class="text-sm text-gray-600 dark:text-gray-300 leading-relaxed mb-6 max-w-2xl">
                {description}
              </p>
              
              <div class="flex flex-wrap gap-4">
                {githubUrl && (
                  <a 
                    href={githubUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-2 px-4 py-2 bg-transparent text-gray-600 dark:text-gray-400 border border-gray-300 dark:border-white/10 hover:border-gray-400 dark:hover:border-white/20 hover:text-black dark:hover:text-white text-xs font-medium uppercase tracking-wider transition-colors"
                  >
                    <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
                    View Source
                  </a>
                )}
                {demoUrl && (
                  <a 
                    href={demoUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-2 px-4 py-2 bg-gray-900 text-white dark:bg-white dark:text-black text-xs font-medium uppercase tracking-wider hover:bg-gray-800 dark:hover:bg-gray-200 transition-colors"
                  >
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
                    Launch Demo
                  </a>
                )}
              </div>
            </div>

            <!-- Tech Matrix Side -->
            <div class="w-full md:w-64 shrink-0 bg-gray-50 dark:bg-black/20 border border-gray-200 dark:border-white/5 p-4 rounded-sm">
              <div class="text-[10px] font-mono text-gray-400 uppercase tracking-widest mb-3 border-b border-gray-200 dark:border-white/10 pb-1">
                Tech_Matrix
              </div>
              <div class="flex flex-wrap gap-2 mb-4">
                {techStack.map((t: string) => (
                  <span class="text-[10px] font-mono px-2 py-1 bg-white dark:bg-white/5 border border-gray-200 dark:border-white/10 text-gray-600 dark:text-gray-300">
                    {t}
                  </span>
                ))}
              </div>
              
              <div class="text-[10px] font-mono text-gray-400 uppercase tracking-widest mb-3 border-b border-gray-200 dark:border-white/10 pb-1 mt-4">
                System_Meta
              </div>
              <div class="space-y-2 text-xs font-mono text-gray-500 dark:text-gray-400">
                <div class="flex justify-between">
                  <span>Version</span>
                  <span class="text-gray-900 dark:text-white">{version}</span>
                </div>
                <div class="flex justify-between">
                  <span>Date</span>
                  <span>{date}</span>
                </div>
                <div class="flex justify-between">
                  <span>License</span>
                  <span>MIT</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Markdown Content -->
      <div class="relative flex flex-col bg-surface-light dark:bg-surface border border-border-subtle-light dark:border-border-subtle min-h-[60vh]">
        
        <!-- Header -->
        <div class="flex items-center justify-between px-4 py-3 border-b border-border-subtle-light dark:border-border-subtle bg-black/[0.02] dark:bg-white/[0.02]">
          <h3 class="text-xs font-semibold font-mono tracking-widest text-gray-900 dark:text-gray-100 uppercase">README.MD</h3>
        </div>

        <!-- Body -->
        <article class="flex-1 p-6">
          <div class="markdown-content markdown-content--sm max-w-none">
            <Content />
          </div>

          <div class="mt-12 pt-6 border-t border-dashed border-gray-200 dark:border-white/10">
            <div class="flex items-start gap-3 p-4 bg-accent-orange/5 border border-accent-orange/20 rounded-sm">
              <svg class="w-4 h-4 text-accent-orange shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
              <div class="text-xs text-gray-600 dark:text-gray-400 font-mono">
                <strong class="text-accent-orange block mb-1">DISCLAIMER: EXPERIMENTAL SOFTWARE</strong>
                This module is a proof-of-concept. It may contain bugs, incomplete features, or unoptimized code. Use in production environments is not recommended without extensive auditing.
              </div>
            </div>
          </div>
        </article>
      </div>
    </div>
  </div>
</Layout>
