---
import { ViewTransitions } from "astro:transitions";
import "../styles/global.css";

// Import persistent React components
import Navbar from "../components/react/Navbar";
import Dock from "../components/react/Dock";
import StatusBar from "../components/react/StatusBar";
import ThemeTransitionOverlay from "../components/react/ThemeTransitionOverlay";
import AuraBlob from "../components/react/AuraBlob";

interface Props {
  title?: string;
  description?: string;
}

const { title = "ankeeth.dev", description = "Building the Intelligent System for the AI-native future." } = Astro.props;
const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <ViewTransitions />
    
    <!-- Theme initialization script - runs before paint -->
    <script is:inline>
      (function() {
        const stored = localStorage.getItem('ankeeth-dev-theme-v1');
        if (stored) {
          const theme = JSON.parse(stored);
          if (theme === 'light') {
            document.documentElement.classList.remove('dark');
          }
        }
      })();
    </script>
  </head>
  <body class="min-h-screen bg-oat dark:bg-graphite flex flex-col font-sans relative z-10 text-gray-800 dark:text-gray-300 transition-colors duration-300 pb-20">
    
    <!-- Navbar - client:only to avoid SSR hook issues with Jotai -->
    <Navbar client:only="react" currentPath={currentPath} transition:persist="navbar" />

    <!-- Main Content Area -->
    <main class="flex-1 max-w-[1920px] w-full mx-auto px-6 py-8 mb-8">
      <slot />
    </main>

    <!-- Floating Dock (Desktop) - No Jotai, safe to SSR -->
    <Dock client:load currentPath={currentPath} transition:persist="dock" />

    <!-- Status Bar - client:only to avoid SSR hook issues with Jotai -->
    <StatusBar client:only="react" transition:persist="statusbar" />

    <!-- Theme Animation Overlay - client:only to avoid SSR hook issues with Jotai -->
    <ThemeTransitionOverlay client:only="react" transition:persist="theme-overlay" />

    <!-- Floating Aura orb + help bubble + Aura modal -->
    <AuraBlob client:only="react" transition:persist="aura-blob" />

    <!-- Theme sync script -->
    <script>
      document.addEventListener('astro:page-load', () => {
        const stored = localStorage.getItem('ankeeth-dev-theme-v1');
        if (stored) {
          try {
            const theme = JSON.parse(stored);
            if (theme === 'light') {
              document.documentElement.classList.remove('dark');
            } else {
              document.documentElement.classList.add('dark');
            }
          } catch (e) {
            console.error('Error parsing theme', e);
          }
        }
      });
    </script>
  </body>
</html>
